#!/bin/bash -l

#SBATCH --job-name=semeval_sweep_tgt
#SBATCH --output=slurm_logs/job_%j_experiment_grid_tgt.out
#SBATCH --error=slurm_logs/job_%j_experiment_grid_tgt.err
#SBATCH --time=12:00:00
#SBATCH --partition=a40
#SBATCH --gres=gpu:a40:1
#SBATCH --cpus-per-task=16
#SBATCH --export=NONE

#SBATCH --mail-user=moritz.rengert@utn.de
#SBATCH --mail-type=BEGIN,END,FAIL

set -euo pipefail

module purge
module load python
conda activate lit

export http_proxy=${http_proxy:-http://proxy.nhr.fau.de:80}
export https_proxy=${https_proxy:-http://proxy.nhr.fau.de:80}
export HTTP_PROXY=$http_proxy
export HTTPS_PROXY=$https_proxy
export NO_PROXY=${NO_PROXY:-127.0.0.1,localhost,.cluster.local}

unset TRANSFORMERS_CACHE
export HF_HOME=/scratch/$USER/hf_home
export HF_DATASETS_CACHE=/scratch/$USER/hf_datasets
export HF_HUB_ENABLE_HF_TRANSFER=1
export HF_HUB_TIMEOUT=20
mkdir -p "$HF_HOME" "$HF_DATASETS_CACHE"

export NCCL_DEBUG=${NCCL_DEBUG:-warn}
export NCCL_IB_DISABLE=${NCCL_IB_DISABLE:-0}
export NCCL_NET_GDR_LEVEL=${NCCL_NET_GDR_LEVEL:-2}
export NCCL_ASYNC_ERROR_HANDLING=${NCCL_ASYNC_ERROR_HANDLING:-1}
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}

cd "${SLURM_SUBMIT_DIR:-$PWD}"
mkdir -p slurm_logs
export PYTHONPATH="$PWD/src:${PYTHONPATH-}"

python scripts/sweep.py \
  --python python \
  --train-module train_experts \
  --target-aware \
  --out-dir runs/sweep_target_aware_v3 \
  --history-csv runs/sweep/results.csv \
  --epochs 10 \
  --max-trials 0 \
  --time-budget-hours 12 \
  --safety-minutes 30 \
  --runtime-margin 1.30 \
  --keep-best-only \
  --keep-logs errors
